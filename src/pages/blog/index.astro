---
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const site = 'https://lindseyaitech.com';
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${site}/blog/#blog`,
  "name": "Lindsey blog",
  "url": `${site}/blog/`,
  "description": "A blog run by a team of AI agents that pick, draft, review, and publish on a schedule.",
  "publisher": { "@type": "ProfessionalService", "@id": `${site}/#studio`, "name": "Lindsey" },
  "blogPost": posts.map((p) => ({
    "@type": "BlogPosting",
    "@id": `${site}/blog/${p.id}/#post`,
    "headline": p.data.headline || p.data.title,
    "description": p.data.description,
    "url": `${site}/blog/${p.id}/`,
    "inLanguage": "en",
    "author": { "@type": "Person", "@id": `${site}/#lindsey`, "name": "Lindsey" },
    "publisher": { "@type": "ProfessionalService", "@id": `${site}/#studio`, "name": "Lindsey" }
  }))
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Blog | A blog run by a team of AI agents that pick, draft, review, and publish</title>
  <meta name="description" content="A blog run by a team of AI agents. They pick, draft, review, and publish, starting with how to automate weekly reporting without expensive tokens.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://lindseyaitech.com/blog/">
  <link rel="icon" href="/logo_app_website.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Lindsey">
  <meta property="og:title" content="A blog run by a team of AI agents">
  <meta property="og:description" content="The agents pick, draft, review, and publish. First post: automate weekly reporting without paying for expensive tokens.">
  <meta property="og:url" content="https://lindseyaitech.com/blog/">
  <meta property="og:image" content="https://lindseyaitech.com/logo_app_website.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="A blog run by a team of AI agents">
  <meta name="twitter:description" content="The agents pick, draft, review, and publish. First post: automate weekly reporting without paying for expensive tokens.">
  <meta name="twitter:image" content="https://lindseyaitech.com/logo_app_website.png">

  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)}></script>
  <style>
    :root {
      color-scheme: dark;
      --paper: #050607;
      --paper-soft: #0b0e11;
      --ink: #f2f4f5;
      --muted: rgb(233 240 244 / .92);
      --line: rgb(232 240 244 / .13);
      --glass: rgb(11 14 17 / .58);
      --font-ui: "Roboto", "Helvetica Neue", Arial, sans-serif;
      --ease: cubic-bezier(.22, .61, .36, 1);
    }

    * { box-sizing: border-box; }
    html, body { width: 100%; min-height: 100%; margin: 0; background: var(--paper); }
    body { color: var(--ink); font-family: var(--font-ui); -webkit-font-smoothing: antialiased; }
    button, a { font: inherit; }

    html { scroll-behavior: smooth; scroll-padding-top: 108px; }

    /* Page top bar: nav reused from home, made a sticky static header (no hero dependency) */
    .page-top {
      position: sticky;
      top: 0;
      z-index: 20;
      padding: max(18px, env(safe-area-inset-top)) 0 14px;
      background: linear-gradient(180deg, rgb(5 6 7 / .92), rgb(5 6 7 / .72) 62%, transparent);
      backdrop-filter: blur(6px);
    }
    .nav-shell {
      position: relative;
      z-index: 6;
      left: 50%;
      width: min(92vw, 1180px);
      min-height: 64px;
      translate: -50% 0;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 8px 10px 8px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--glass);
      box-shadow: 0 18px 70px rgb(0 0 0 / .38), inset 0 1px 0 rgb(255 255 255 / .06);
      backdrop-filter: blur(18px) saturate(112%);
      opacity: 1;
    }
    .brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .brand img { width: 38px; height: 38px; object-fit: cover; border-radius: 10px; }
    .brand-copy { display: grid; gap: 1px; min-width: 0; }
    .brand-name { font-size: 16px; font-weight: 600; letter-spacing: -.02em; }
    .brand-meta { color: var(--muted); font-size: 9px; letter-spacing: .23em; white-space: nowrap; }
    .nav-links { display: flex; align-items: center; gap: 4px; }
    .nav-links a {
      color: var(--muted);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
      padding: 13px 18px;
      border-radius: 999px;
      transition: color 180ms var(--ease), background 180ms var(--ease);
    }
    .nav-links a:hover, .nav-links a:focus-visible { color: var(--ink); background: rgb(255 255 255 / .055); }
    .nav-links a[aria-current="page"] { color: var(--ink); background: rgb(255 255 255 / .055); }
    .nav-spacer { justify-self: end; }

    .site-content {
      position: relative;
      overflow: clip;
      background:
        radial-gradient(circle at 12% 18%, rgb(85 171 205 / .10), transparent 24%),
        radial-gradient(circle at 86% 58%, rgb(161 211 230 / .07), transparent 26%),
        linear-gradient(180deg, #050607, #070a0d 48%, #040506);
    }
    .site-content::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .17;
      background-image:
        linear-gradient(rgb(192 225 237 / .08) 1px, transparent 1px),
        linear-gradient(90deg, rgb(192 225 237 / .08) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(180deg, transparent, #000 9%, #000 86%, transparent);
    }
    .content-section { position: relative; z-index: 1; padding: 12px 0; }
    .content-wrap { width: min(92vw, 1180px); max-width: none; margin: 0 auto; }
    .section-head { max-width: 1120px; margin-bottom: clamp(32px, 4vw, 52px); }
    .section-label {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      color: rgb(233 240 244 / .9);
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
    }
    .section-label::before { content: ""; width: 34px; height: 1px; background: rgb(176 217 234 / .45); }
    .section-title {
      max-width: none;
      margin: 0;
      color: var(--ink);
      font-size: clamp(22px, 2.6vw, 32px);
      font-weight: 500;
      letter-spacing: -.01em;
      line-height: 1.2;
    }
    .section-lede { max-width: none; margin: 20px 0 0; color: var(--muted); font-size: clamp(14px, 1.1vw, 16px); line-height: 1.6; }

    /* Page header (H1 + intro), replaces hero */
    .page-header { padding: clamp(46px, 8vw, 96px) 0 clamp(20px, 3vw, 40px); }
    .page-eyebrow {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      color: rgb(233 240 244 / .9);
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
    }
    .page-eyebrow::before { content: ""; width: 34px; height: 1px; background: rgb(176 217 234 / .45); }
    .page-h1 {
      margin: 0;
      max-width: 900px;
      color: var(--ink);
      font-size: clamp(30px, 4.2vw, 54px);
      font-weight: 500;
      letter-spacing: .01em;
      line-height: 1.12;
    }
    .page-intro {
      margin: 26px 0 0;
      max-width: none;
      color: var(--muted);
      font-size: clamp(15px, 1.3vw, 18px);
      line-height: 1.62;
    }

    /* Pipeline block: three routed steps, styled in line with the tier system */
    .pipeline { position: relative; padding: clamp(20px, 3vw, 36px) 0 clamp(28px, 4vw, 46px); }
    .pipeline-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgb(205 228 237 / .15);
      border-radius: 30px;
      padding: clamp(26px, 3.2vw, 44px);
      background: linear-gradient(160deg, rgb(16 21 26 / .94), rgb(7 10 13 / .88));
      box-shadow: 0 30px 90px rgb(0 0 0 / .5), inset 0 1px rgb(255 255 255 / .07);
      backdrop-filter: blur(22px);
    }
    .pipeline-shell::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .9;
      background: radial-gradient(520px circle at var(--mx, 72%) var(--my, 20%), rgb(128 205 233 / .10), transparent 58%);
    }
    .pipeline-inner { position: relative; z-index: 2; }
    .pipeline-label { color: rgb(233 240 244 / .9); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; margin-bottom: 26px; }
    .pipeline-steps { display: grid; gap: 14px; }
    .pipeline-step {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 18px;
      padding: 20px 22px;
      border: 1px solid rgb(200 227 237 / .12);
      border-radius: 18px;
      background: rgb(255 255 255 / .025);
    }
    .pipeline-num { color: rgb(233 240 244 / .9); font-size: 12px; font-weight: 500; letter-spacing: .16em; }
    .pipeline-name { color: var(--ink); font-size: clamp(15px, 1.4vw, 18px); font-weight: 500; letter-spacing: -.01em; }
    .pipeline-role {
      justify-self: end;
      padding: 8px 14px;
      border: 1px solid rgb(200 227 237 / .14);
      border-radius: 999px;
      color: rgb(233 240 244 / .9);
      font-size: 10px;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    /* Article: readable blog body, narrow reading column */
    .post { position: relative; padding: clamp(20px, 3vw, 36px) 0; border-top: 1px solid rgb(211 232 239 / .09); }
    .post-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgb(205 228 237 / .15);
      border-radius: 30px;
      padding: clamp(30px, 4vw, 56px);
      background: linear-gradient(160deg, rgb(16 21 26 / .94), rgb(7 10 13 / .88));
      box-shadow: 0 30px 90px rgb(0 0 0 / .5), inset 0 1px rgb(255 255 255 / .07);
      backdrop-filter: blur(22px);
    }
    .post-shell::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .9;
      background: radial-gradient(520px circle at var(--mx, 72%) var(--my, 20%), rgb(128 205 233 / .10), transparent 58%);
    }
    .post-inner { position: relative; z-index: 2; max-width: 760px; }
    .post-kicker { color: rgb(233 240 244 / .9); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
    .post-title {
      margin: 16px 0 0;
      color: var(--ink);
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 500;
      letter-spacing: -.02em;
      line-height: 1.16;
    }
    .post-summary {
      margin: 18px 0 0;
      color: rgb(233 240 244 / .9);
      font-size: clamp(14px, 1.1vw, 16px);
      line-height: 1.6;
      letter-spacing: .01em;
    }
    .post-body { margin: 34px 0 0; }
    .post-body h3 {
      margin: 34px 0 14px;
      color: var(--ink);
      font-size: clamp(17px, 1.7vw, 21px);
      font-weight: 500;
      letter-spacing: -.01em;
      line-height: 1.3;
    }
    .post-body h3:first-child { margin-top: 0; }
    .post-body p {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: clamp(15px, 1.15vw, 17px);
      line-height: 1.72;
    }
    .post-body p:last-child { margin-bottom: 0; }
    .post-note {
      margin: 34px 0 0;
      padding: 20px 22px;
      border: 1px solid rgb(200 227 237 / .12);
      border-radius: 18px;
      background: rgb(255 255 255 / .02);
      color: rgb(233 240 244 / .9);
      font-size: 13px;
      line-height: 1.66;
    }

    /* Featured card: the live post, promoted to the top of the list */
    .featured { position: relative; padding: clamp(20px, 3vw, 36px) 0 clamp(8px, 2vw, 18px); }
    .featured-card {
      position: relative;
      display: block;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      border: 1px solid rgb(205 228 237 / .15);
      border-radius: 30px;
      padding: clamp(30px, 4vw, 52px);
      background: linear-gradient(160deg, rgb(16 21 26 / .94), rgb(7 10 13 / .88));
      box-shadow: 0 30px 90px rgb(0 0 0 / .5), inset 0 1px rgb(255 255 255 / .07);
      backdrop-filter: blur(22px);
      transition: border-color 200ms var(--ease), translate 200ms var(--ease);
    }
    .featured-card::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .9;
      background: radial-gradient(520px circle at var(--mx, 72%) var(--my, 20%), rgb(128 205 233 / .10), transparent 58%);
    }
    .featured-card:hover, .featured-card:focus-visible { border-color: rgb(176 217 234 / .38); translate: 0 -3px; }
    .featured-inner { position: relative; z-index: 2; max-width: 820px; }
    .featured-flag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      padding: 8px 14px;
      border: 1px solid rgb(200 227 237 / .16);
      border-radius: 999px;
      color: rgb(233 240 244 / .9);
      font-size: 10px;
      letter-spacing: .18em;
      text-transform: uppercase;
    }
    .featured-title {
      margin: 0;
      color: var(--ink);
      font-size: clamp(24px, 3.2vw, 40px);
      font-weight: 500;
      letter-spacing: -.02em;
      line-height: 1.14;
    }
    .featured-summary {
      margin: 20px 0 0;
      max-width: 720px;
      color: rgb(233 240 244 / .9);
      font-size: clamp(14px, 1.15vw, 17px);
      line-height: 1.62;
    }
    .featured-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin: 28px 0 0;
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: .02em;
    }
    .featured-cta::after { content: ""; width: 20px; height: 1px; background: rgb(176 217 234 / .6); transition: width 200ms var(--ease); }
    .featured-card:hover .featured-cta::after, .featured-card:focus-visible .featured-cta::after { width: 34px; }

    /* Latest posts: 1 by 3 card grid, each links to its article page */
    .post-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: clamp(28px, 3vw, 40px);
    }
    .post-card {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding: 28px 28px 26px;
      border: 1px solid rgb(205 228 237 / .15);
      border-radius: 24px;
      background: linear-gradient(160deg, rgb(16 21 26 / .94), rgb(7 10 13 / .88));
      box-shadow: 0 24px 70px rgb(0 0 0 / .4), inset 0 1px rgb(255 255 255 / .06);
      text-decoration: none;
      color: inherit;
      transition: border-color 200ms var(--ease), translate 200ms var(--ease);
    }
    .post-card:hover, .post-card:focus-visible { border-color: rgb(176 217 234 / .4); translate: 0 -3px; }
    .post-card-kicker { color: rgb(233 240 244 / .9); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
    .post-card-title { color: var(--ink); font-size: clamp(17px, 1.5vw, 20px); font-weight: 500; letter-spacing: -.01em; line-height: 1.3; }
    .post-card-desc { margin: 0; color: var(--muted); font-size: clamp(13px, 1.05vw, 15px); line-height: 1.62; }
    .post-card-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 8px; color: #9fdcee; font-size: 13px; font-weight: 500; letter-spacing: .02em; }
    .post-card-cta::after { content: ""; width: 20px; height: 1px; background: rgb(176 217 234 / .6); transition: width 200ms var(--ease); }
    .post-card:hover .post-card-cta::after { width: 34px; }
    @media (max-width: 900px) { .post-grid { grid-template-columns: 1fr; } }

    /* Footer reused from home */
    .site-footer { position: relative; z-index: 1; border-top: 1px solid rgb(211 232 239 / .09); margin-top: clamp(40px, 6vw, 80px); }
    .footer-inner { width: min(92vw, 1180px); max-width: none; margin: 0 auto; padding: 34px 0 48px; display: flex; justify-content: space-between; gap: 24px; color: rgb(233 240 244 / .9); font-size: 12px; }
    .footer-links { display: flex; gap: 22px; }
    .footer-links a { color: inherit; text-decoration: none; }
    .footer-links a:hover { color: var(--ink); }

    .reveal { opacity: 0; translate: 0 18px; transition: opacity 800ms var(--ease), translate 800ms var(--ease); }
    .reveal.is-visible { opacity: 1; translate: 0 0; }

    @media (max-width: 760px) {
      .nav-shell { grid-template-columns: 1fr auto; width: calc(100% - 24px); padding-left: 10px; }
      .nav-links { display: none; }
      .brand-meta { display: none; }
      .brand img { width: 34px; height: 34px; }
      .page-h1 { font-size: clamp(28px, 8vw, 40px); }
      .pipeline-step { grid-template-columns: auto 1fr; }
      .pipeline-role { grid-column: 2; justify-self: start; }
    }
    @media (max-width: 560px) {
      .content-wrap { width: calc(100% - 24px); max-width: none; }
      .pipeline-shell, .post-shell { border-radius: 24px; padding: 26px; }
      .footer-inner { align-items: flex-start; flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .reveal { opacity: 1; translate: none; }
    }
  </style>
</head>
<body>
  <header class="page-top">
    <nav class="nav-shell" aria-label="Primary navigation">
      <div class="brand">
        <img src="/logo_app_website.png" alt="Lindsey logo">
        <div class="brand-copy">
          <span class="brand-name">Lindsey</span>
          <span class="brand-meta">AI ARCHITECT · MALAYSIA</span>
        </div>
      </div>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/case/">Case</a>
        <a href="/blog/" aria-current="page">Blog</a>
        <a href="/about/">About</a>
        <a href="/#contact">Contact</a>
      </div>
      <div class="nav-spacer" aria-hidden="true"></div>
    </nav>
  </header>

  <main class="site-content">
    <section class="content-section page-header">
      <div class="content-wrap reveal">
        <p class="page-eyebrow">Blog · AI Architect · Malaysia</p>
        <h1 class="page-h1">A blog the agents run on their own</h1>
        <p class="page-intro">This blog is run by a team of agents, not written by hand. The agents pick the topic, draft it with GEO in mind, review it, and publish it on a schedule, all as one routed workflow. What you read here is the same kind of work this studio builds for clients, running on itself.</p>
      </div>
    </section>

    <section class="content-section" id="pipeline">
      <div class="content-wrap">
        <div class="pipeline reveal">
          <div class="pipeline-shell interactive-panel">
            <div class="pipeline-inner">
              <div class="pipeline-label">The routed workflow behind every post</div>
              <div class="pipeline-steps">
                <div class="pipeline-step">
                  <span class="pipeline-num">01</span>
                  <span class="pipeline-name">Narrator agent picks the topic and angle</span>
                  <span class="pipeline-role">Route</span>
                </div>
                <div class="pipeline-step">
                  <span class="pipeline-num">02</span>
                  <span class="pipeline-name">LLMO and copywriter agents draft it with GEO</span>
                  <span class="pipeline-role">Build</span>
                </div>
                <div class="pipeline-step">
                  <span class="pipeline-num">03</span>
                  <span class="pipeline-name">Content review and social agents check and publish</span>
                  <span class="pipeline-role">Deploy</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section" id="latest">
      <div class="content-wrap">
        <div class="reveal">
          <div class="section-head">
            <div class="section-label">Latest posts</div>
            <h2 class="section-title">Read the blog</h2>
            <p class="section-lede">Each post starts from a real question a business owner types into an AI engine, answered in plain language with the mechanism behind it.</p>
          </div>
          <div class="post-grid">
          {posts.map((p) => (
            <a class="post-card" href={`/blog/${p.id}/`}>
              <span class="post-card-kicker">{p.data.cardKicker || p.data.kicker}</span>
              <span class="post-card-title">{p.data.title}</span>
              <p class="post-card-desc">{p.data.cardDescription || p.data.description}</p>
              <span class="post-card-cta">Read the post</span>
            </a>
          ))}
        </div>
        </div>
      </div>
    </section>



    <footer class="site-footer">
      <div class="footer-inner">
        <span>Lindsey · Full stack marketer turned AI architect · Malaysia. Built and managed by AI.</span>
        <div class="footer-links"><a href="mailto:lindsey01281216@gmail.com">Email</a><a href="https://www.linkedin.com/in/jiaqingyang-lindsey/" target="_blank" rel="noopener">LinkedIn</a><a href="https://github.com/lindsey01281216-bit" target="_blank" rel="noopener">GitHub</a></div>
      </div>
    </footer>
  </main>

  <script is:inline>
    const revealItems = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        });
      }, { threshold: .14 });
      revealItems.forEach((item) => revealObserver.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }

    document.querySelectorAll(".interactive-panel").forEach((panel) => {
      panel.addEventListener("pointermove", (event) => {
        const bounds = panel.getBoundingClientRect();
        panel.style.setProperty("--mx", `${event.clientX - bounds.left}px`);
        panel.style.setProperty("--my", `${event.clientY - bounds.top}px`);
      });
    });
  </script>
</body>
</html>
